  "beats": [
    {
      "title": "The throne room",
      "narration": "Stars wheel past the open deck of the Star Forge. Jedi hang frozen in stasis around the platform. At its heart, Darth Malak waits, and Bastila stands at his side in dark robes.",
      "notes": "Standoff. Slow push in on Malak and Bastila.",
      "actions": [
        {
          "do": "say",
          "id": "malak",
          "text": "Welcome. I have been expecting you. Your friends are here too; they will not be leaving."
        },
        {
          "do": "say",
          "id": "bastila",
          "text": "You should not have come. There is nothing left here for you to save."
        }
      ]
    },
    {
      "title": "Apprentice against Jedi",
      "narration": "Malak gestures. Bastila's double blade ignites.",
      "notes": "Frees the players. Bastila fights them; Malak and his guards only watch.",
      "actions": [
        {
          "do": "freezePlayers",
          "on": false
        },
        {
          "do": "say",
          "id": "malak",
          "text": "Destroy this Jedi, apprentice, and take your place at my side."
        },
        {
          "do": "order",
          "ids": [
            "bastila"
          ],
          "order": {
            "kind": "attack",
            "target": "players"
          }
        },
        {
          "do": "animate",
          "ids": [
            "malak"
          ],
          "gesture": "point"
        }
      ]
    },
    {
      "title": "The feast",
      "narration": "Malak turns to the frozen Jedi and opens his hand. One after another, they convulse and fall.",
      "notes": "Malak drains the captives; set piece while the duel goes on.",
      "actions": [
        {
          "do": "animate",
          "ids": [
            "malak"
          ],
          "gesture": "power"
        },
        {
          "do": "animate",
          "ids": [
            "captive1",
            "captive2",
            "captive3",
            "captive4"
          ],
          "stance": "spasm"
        },
        {
          "do": "say",
          "id": "malak",
          "text": "Their strength becomes mine. As yours will."
        },
        {
          "do": "animate",
          "ids": [
            "captive1",
            "captive2",
            "captive3",
            "captive4"
          ],
          "stance": "dead_face"
        }
      ]
    },
    {
      "title": "Redemption",
      "narration": "Bastila lowers her blade. She looks from the dead Jedi to her master, and turns.",
      "notes": "Bastila changes sides. Malak and his guards attack.",
      "actions": [
        {
          "do": "faction",
          "ids": [
            "bastila"
          ],
          "faction": "friendly"
        },
        {
          "do": "order",
          "ids": [
            "bastila"
          ],
          "order": {
            "kind": "attack",
            "target": "guards"
          }
        },
        {
          "do": "say",
          "id": "bastila",
          "text": "No. Never again. I am a Jedi, Malak, like the ones you murdered."
        },
        {
          "do": "order",
          "ids": [
            "guards"
          ],
          "order": {
            "kind": "attack",
